# =============================================================================
# Controle de Estoque — Backend — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env com dados reais.
# =============================================================================

# ── Ambiente ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3333

# ── Banco de Dados ────────────────────────────────────────────────────────────
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_BANCO
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/controle_estoque

# ── JWT ───────────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 64
JWT_SECRET=MUDE_ESTE_SEGREDO_minimo_32_caracteres_use_openssl_rand_base64_64
JWT_EXPIRES_IN=28800
JWT_REFRESH_EXPIRES_IN=604800

# ── CORS / Frontend ───────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Administrador Master (criado pelo seed) ───────────────────────────────────
# OBRIGATÓRIO — altere antes de qualquer deploy
MASTER_EMAIL=master@controleestoque.com
MASTER_SENHA=AltereMeSenhaForte@2026

# ── SaaS / Multi-tenant ───────────────────────────────────────────────────────
PLATFORM_NAME=ERP SaaS
PLATFORM_EMAIL=contato@suaplataforma.com
SAAS_TRIAL_DAYS=14
INVITE_TOKEN_EXPIRES_HOURS=48

# ── E-mail (opcional — necessário para reset de senha e convites) ─────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=sua-senha-de-app
EMAIL_FROM="ERP SaaS <noreply@suaplataforma.com>"

# ── Inteligência Artificial (opcional) ───────────────────────────────────────
# Provider ativo: anthropic | openai | local (sem IA)
AI_PROVIDER=local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7

# ── Pagamentos PIX (opcional) ─────────────────────────────────────────────────
# Provider ativo: mock | mercadopago | pagseguro | asaas | gerencianet | stripe
PIX_PROVIDER=mock
MERCADOPAGO_ACCESS_TOKEN=
PAGSEGURO_TOKEN=
PAGSEGURO_EMAIL=
ASAAS_API_KEY=
ASAAS_ENV=sandbox
GERENCIANET_CLIENT_ID=
GERENCIANET_CLIENT_SECRET=
GERENCIANET_PIX_KEY=
GERENCIANET_ENV=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── WhatsApp (opcional) ───────────────────────────────────────────────────────
# Provider ativo: mock | meta | evolution | zapi
WHATSAPP_PROVIDER=mock
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_ID=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=

# ── Storage de imagens (opcional) ─────────────────────────────────────────────
# Provider ativo: local | s3 | cloudinary
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Fiscal (opcional) ─────────────────────────────────────────────────────────
FISCAL_PROVIDER=mock

# ── Impressão térmica (opcional) ──────────────────────────────────────────────
PRINT_PROVIDER=local
PRINTER_HOST=
PRINTER_PORT=9100
