# =============================================================================
# Controle de Estoque — Frontend — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# =============================================================================

# URL base da API backend (sem /api/v1)
# Deixe vazio em desenvolvimento para usar o proxy do Vite (recomendado)
# Em produção: https://api.suaempresa.com
VITE_API_URL=

# URL do WebSocket (opcional — padrão usa a mesma origem que VITE_API_URL)
VITE_WS_URL=
