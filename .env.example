# ============================================================
# Controle de Estoque — Docker Compose — Variáveis de Ambiente
# Copie para .env e preencha os valores antes de rodar o deploy
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_esta_senha_forte_aqui
POSTGRES_DB=controle_estoque

# ── Backend ─────────────────────────────────────────────────
# Gere com: openssl rand -base64 64
JWT_SECRET=GERE_UM_SEGREDO_LONGO_E_ALEATORIO_AQUI_openssl_rand_base64_64
JWT_EXPIRES_IN=86400
BACKEND_PORT=3333

# Origem permitida pelo CORS (URL do frontend em produção)
CORS_ORIGIN=http://localhost

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_PORT=80
# URL pública da API (usada no build do frontend)
VITE_API_URL=http://localhost:3333
